# Copier en .env (non versionné) et adapter.

# Domaine public servi par Caddy (HTTPS automatique). « localhost » pour tester en local.
DOMAINE=localhost

# Mot de passe de la base Postgres (interne : jamais exposée hors de Docker).
POSTGRES_PASSWORD=change-moi

# Banc de revue (service « revue », profil admin) : empreintes GPG des admins de confiance,
# séparées par des virgules. Leurs clés publiques : opendata/data/revue/admins/*.asc.
REVUE_ADMINS_GPG=
