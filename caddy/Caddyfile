# Entrée publique de big-brother : HTTPS automatique (Let's Encrypt), un seul domaine.
#   https://{$DOMAINE}/            app web « Nos administrés ont du talent » (service web)
#   https://{$DOMAINE}/donnees/…   publication opendata (service publication) : index.json, bases, correctifs
#
# Variables (fichier .env à la racine, voir .env.example) :
#   DOMAINE      nom de domaine public ; « localhost » pour tester en local (certificat interne de Caddy)
#   ACME_EMAIL   contact Let's Encrypt (expiration de certificat, incidents)

{
	email {$ACME_EMAIL}
}

{$DOMAINE} {
	# Compression des réponses textuelles (HTML, JS, JSON, wasm). Les bases .db.gz, déjà
	# compressées et servies en application/octet-stream, ne sont pas recompressées.
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}

	# Publication opendata : directement depuis le service publication (CORS, cache, courante.db
	# bloquée : règles posées par son nginx). /donnees est retiré avant de transmettre.
	handle_path /donnees/* {
		reverse_proxy publication:80
	}

	# Tout le reste : l'app web (application monopage, en-têtes COOP/COEP posés par son nginx).
	handle {
		reverse_proxy web:80
	}

	log {
		output stdout
		format json
	}
}
