# Copier en .env (env par défaut) ou en .env.<env> (ex. .env.staging), choisi par
# `npm run app -- <commande> --env=<env>`. Seul ce fichier est lu (voir scripts/app.mjs).

# Identifiant de l'app : bundle iOS et package Android. À fixer avant la première publication
# (il ne change plus ensuite) ; un identifiant par env permet d'installer les deux côte à côte.
APP_ID=fr.nospolitiques.augure

# Bus de commandes : api (défaut) ou fixtures (maquette, sans réseau).
EXPO_PUBLIC_SOURCE=api

# Adresse de l'API vue par l'appareil. Émulateur Android : http://10.0.2.2:8082 ; appareil réel :
# l'adresse du poste sur le réseau local (http://192.168.x.y:8082) ou l'API publique, derrière
# Caddy sous /api (https://<domaine>/api : sans /api, le site web répond 405).
EXPO_PUBLIC_API_URL=http://localhost:8082

# Facultatif : équipe Apple qui signe l'archive iOS (build xcarchive).
# APPLE_TEAM_ID=
